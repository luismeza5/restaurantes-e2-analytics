# Copy to .env and adjust. Consumed by docker-compose and the Spark jobs.

# --- warehouse (serving star schema + OLAP cubes) ---
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_JDBC_URL=jdbc:postgresql://warehouse-db:5432/warehouse

# --- pipeline ---
WAREHOUSE_MODE=lake          # lake (compose) | local (dev/CI)
HIVE_ENABLED=0               # 1 only when the `lake` profile / metastore is up
SPARK_INCLUDE_JDBC=1         # fetch the Postgres JDBC driver for load_warehouse
LAKE_PATH=/lake/warehouse
SOURCE_KIND=csv              # csv | postgres | mongo
SOURCE_PATH=/opt/project/data/source

# --- source = Proyecto 1 (only when SOURCE_KIND != csv) ---
# SOURCE_JDBC_URL=jdbc:postgresql://proy1-db:5432/restaurant
# SOURCE_USER=app
# SOURCE_PASSWORD=app
# SOURCE_MONGO_URI=mongodb://proy1-mongo:27017
# SOURCE_MONGO_DB=restaurant

# --- graph ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpass
ROUTING_AVG_SPEED_KMH=28

# --- integration with Proyecto 1 (ElasticSearch reindex) ---
PROY1_REINDEX_URL=
